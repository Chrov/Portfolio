table Annual
	column year
		dataType: int64
		sourceColumn: year
		summarizeBy: none

	column production_kt
		dataType: double
		sourceColumn: production_kt
		summarizeBy: sum

	column price_us_cent_lb
		dataType: double
		sourceColumn: price_us_cent_lb
		summarizeBy: sum

	column exports_usd_m
		dataType: double
		sourceColumn: exports_usd_m
		summarizeBy: sum

	measure 'Production kt' = SUM(Annual[production_kt])
		formatString: #,0.0

	measure 'Exports USD m' = SUM(Annual[exports_usd_m])
		formatString: #,0.0

	measure 'Price cents lb' = AVERAGE(Annual[price_us_cent_lb])
		formatString: #,0.0

	partition Annual = m
		mode: import
		source =
			let
			 Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64),[Delimiter=",",Columns=4,Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
			 Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
			 Typed = Table.TransformColumnTypes(Headers,{{"year",Int64.Type},{"production_kt",type number},{"price_us_cent_lb",type number},{"exports_usd_m",type number}})
			in Typed
